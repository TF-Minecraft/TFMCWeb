# Runs patch note rewrites on the host: Claude first, the Codex CLI as backup.
#   useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin tfmc-patchnotes
#   install -m 600 /dev/null /etc/tfmc/patchnotes-claude.env   then set CLAUDE_CODE_OAUTH_TOKEN=... in it
#   install -m 600 /dev/null /etc/tfmc/patchnotes.env   then set STAFF_KEY=... in it
#   install -m 755 scripts/patchnotes-update.py /usr/local/sbin/tfmc-patchnotes-update
#   cp scripts/tfmc-patchnotes-*.service scripts/tfmc-patchnotes-*.timer /etc/systemd/system/
#   systemctl daemon-reload && tfmc-patchnotes-update <commit on main>
#   systemctl enable --now tfmc-patchnotes-rewrite tfmc-patchnotes-watch.timer tfmc-patchnotes-weekly.timer
[Unit]
Description=TFMC patch note rewrite worker
After=network-online.target docker.service

[Service]
Type=simple
# STAFF_KEY, and API_BASE_URL when the API is not on 127.0.0.1:8000.
EnvironmentFile=/etc/tfmc/patchnotes.env
# The Claude login (CLAUDE_CODE_OAUTH_TOKEN, or PATCHNOTES_ANTHROPIC_API_KEY) and PATCHNOTES_WRITERS.
# Without it the worker goes straight to Codex.
EnvironmentFile=-/etc/tfmc/patchnotes-claude.env
Environment=HOME=/root
Environment=PYTHONPATH=/usr/local/lib/tfmc-patchnotes/current
Environment=PATCHNOTES_CLAUDE_BIN=/usr/local/bin/claude
Environment=PATCHNOTES_CLAUDE_USER=tfmc-patchnotes
Environment=PATCHNOTES_BACKUPS_DIR=/root/backups
Environment=PATCHNOTES_CODEX_BIN=/root/.npm-global/bin/codex
Environment=PATH=/root/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/
ExecStart=/usr/bin/python3 -B -m patchnotes.rewrite_worker
Restart=always
RestartSec=5

# Claude runs as tfmc-patchnotes, which cannot enter /root, so it reaches neither
# the Codex login nor the backups. For the final check the worker copies the
# gameplay configs of Friday's backup into Claude's own working directory.
# The model reads commit subjects, which are untrusted text. The Codex login
# belongs to root, so the service stays root, but it runs the root-owned copy
# that tfmc-patchnotes-update installs, sees an empty /home and /root apart from
# the CLI and its login, and cannot reach Docker.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
TemporaryFileSystem=/home:ro /root:ro,mode=0700 /etc/tfmc:ro
BindReadOnlyPaths=/root/.npm-global -/home/amp/.ampdata/instances/TFMCMain01/Backups:/root/backups
BindPaths=/root/.codex
InaccessiblePaths=-/run/docker.sock -/run/containerd -/var/lib/docker -/var/lib/tfmc -/var/log -/opt -/srv -/mnt -/media

[Install]
WantedBy=multi-user.target
