[Unit]
Description=TFMC Minecraft server control
After=network.target
Before=docker.service

[Service]
Type=simple
User=tfmc-server-control
Group=tfmc-server-control
# The website backends run as tfmc with this group, so the sockets are shared with it.
SupplementaryGroups=tfmc-control
WorkingDirectory=/usr/local/lib/tfmc-server-control/backend
Environment=SERVER_CONTROL_HOME=/var/lib/tfmc-server-control
Environment=SERVER_CONTROL_SOCKET_DIR=/run/tfmc-server-control
Environment=SERVER_CONTROL_LOG_TIMEZONE=Etc/UTC
Environment=SERVER_CONTROL_SOCKET_GROUP=tfmc-control
Environment=PYTHONNOUSERSITE=1
# The AMP login for every server call: root-owned JSON {"username", "password"}.
# Without the file the credential is empty: the helper starts, but knows no servers.
LoadCredential=amp-login:/etc/tfmc/server-control-amp-login
SetCredential=amp-login:
NoNewPrivileges=true
ExecStartPre=/usr/bin/install -d -m 0755 /run/tfmc-server-control/www /run/tfmc-server-control/dev
ExecStart=/usr/bin/python3 -B -m src.servers.host
StateDirectory=tfmc-server-control
StateDirectoryMode=0700
RuntimeDirectory=tfmc-server-control
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectSystem=strict
# Server files are reached through the AMP API, never the filesystem.
ProtectHome=true

[Install]
WantedBy=multi-user.target
